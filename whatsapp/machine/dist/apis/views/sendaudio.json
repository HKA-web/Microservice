{
  "paths": {
    "/api/send-audio": {
      "post": {
        "summary": "Kirim audio WhatsApp (single atau multi)",
        "tags": ["WhatsApp"],
        "description": "Gunakan `_botDevice` untuk memilih device tertentu. Jika tidak diberikan, session pertama akan dipakai. Gunakan `ptt: true` untuk mengirim sebagai voice note.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "_botDevice": {
                        "type": "string",
                        "description": "Device ID / nomor WA"
                      },
                      "jid": {
                        "type": "string",
                        "description": "Nomor WhatsApp tujuan"
                      },
                      "audioUrl": {
                        "type": "string",
                        "description": "URL audio (mp3 / ogg)"
                      },
                      "ptt": {
                        "type": "boolean",
                        "description": "Jika true akan dikirim sebagai voice note",
                        "default": false
                      }
                    },
                    "required": ["jid", "audioUrl"]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "_botDevice": {
                        "type": "string",
                        "description": "Device ID / nomor WA"
                      },
                      "messages": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "jid": {
                              "type": "string",
                              "description": "Nomor WhatsApp tujuan"
                            },
                            "audioUrl": {
                              "type": "string",
                              "description": "URL audio (mp3 / ogg)"
                            },
                            "ptt": {
                              "type": "boolean",
                              "description": "Jika true akan dikirim sebagai voice note",
                              "default": false
                            }
                          },
                          "required": ["jid", "audioUrl"]
                        }
                      }
                    },
                    "required": ["messages"]
                  }
                ]
              },
              "examples": {
                "singleAudio": {
                  "summary": "Kirim satu audio",
                  "value": {
                    "_botDevice": "628xxxxxx",
                    "jid": "62856xxxxxx@s.whatsapp.net",
                    "audioUrl": "https://example.com/audio.mp3",
                    "ptt": false
                  }
                },
                "voiceNote": {
                  "summary": "Kirim sebagai voice note",
                  "value": {
                    "jid": "62856xxxxxx@s.whatsapp.net",
                    "audioUrl": "https://example.com/voice.ogg",
                    "ptt": true
                  }
                },
                "multiAudio": {
                  "summary": "Kirim banyak audio sekaligus",
                  "value": {
                    "_botDevice": "6285183xxxxxxx",
                    "messages": [
                      {
                        "jid": "628564xxxxx@s.whatsapp.net",
                        "audioUrl": "https://example.com/a1.mp3",
                        "ptt": false
                      },
                      {
                        "jid": "628121xxxxx@s.whatsapp.net",
                        "audioUrl": "https://example.com/a2.ogg",
                        "ptt": true
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Hasil pengiriman audio per nomor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "jid": { "type": "string" },
                          "error": { "type": "string", "nullable": true }
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "successAll": {
                    "summary": "Semua audio berhasil dikirim",
                    "value": {
                      "data": [
                        { "jid": "628564xxxxx@s.whatsapp.net", "error": null },
                        { "jid": "628121xxxxx@s.whatsapp.net", "error": null }
                      ]
                    }
                  },
                  "partialError": {
                    "summary": "Beberapa audio gagal",
                    "value": {
                      "data": [
                        { "jid": "628564xxxxx@s.whatsapp.net", "error": null },
                        { "jid": "628121xxxxx@s.whatsapp.net", "error": "Socket WA belum siap" }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Device tidak ditemukan atau field wajib tidak ada",
            "content": {
              "application/json": {
                "example": { "error": "Device tidak ditemukan" }
              }
            }
          },
          "500": {
            "description": "Tidak ada device WA aktif atau socket belum siap",
            "content": {
              "application/json": {
                "example": { "error": "Tidak ada device WA aktif" }
              }
            }
          }
        }
      }
    }
  }
}