{
  "paths": {
    "/api/send-image": {
      "post": {
        "summary": "Kirim gambar WhatsApp (single atau multi)",
        "tags": ["WhatsApp"],
        "description": "Gunakan `_botDevice` untuk memilih device tertentu. Jika tidak diberikan, session pertama akan dipakai.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "_botDevice": {
                        "type": "string",
                        "description": "Device ID / nomor WA"
                      },
                      "jid": {
                        "type": "string",
                        "description": "Nomor WhatsApp tujuan (format: 628xxx@s.whatsapp.net)"
                      },
                      "imageUrl": {
                        "type": "string",
                        "description": "URL gambar (https://...)"
                      },
                      "caption": {
                        "type": "string",
                        "nullable": true
                      },
                      "fileName": {
                        "type": "string",
                        "nullable": true
                      }
                    },
                    "required": ["jid", "imageUrl"]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "_botDevice": {
                        "type": "string"
                      },
                      "images": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "jid": {
                              "type": "string"
                            },
                            "imageUrl": {
                              "type": "string"
                            },
                            "caption": {
                              "type": "string",
                              "nullable": true
                            },
                            "fileName": {
                              "type": "string",
                              "nullable": true
                            }
                          },
                          "required": ["jid", "imageUrl"]
                        }
                      }
                    },
                    "required": ["images"]
                  }
                ]
              },
              "examples": {
                "singleImage": {
                  "summary": "Kirim satu gambar",
                  "value": {
                    "_botDevice": "6285183xxxxxxx",
                    "jid": "628564xxxxx@s.whatsapp.net",
                    "imageUrl": "https://example.com/image.jpg",
                    "caption": "Ini gambar dari bot 🖼️",
                    "fileName": "promo.jpg"
                  }
                },
                "multiImage": {
                  "summary": "Kirim banyak gambar sekaligus",
                  "value": {
                    "_botDevice": "6285183xxxxxxx",
                    "images": [
                      {
                        "jid": "628564xxxxx@s.whatsapp.net",
                        "imageUrl": "https://example.com/img1.jpg",
                        "caption": "Gambar pertama"
                      },
                      {
                        "jid": "628121xxxxxx@s.whatsapp.net",
                        "imageUrl": "https://example.com/img2.jpg",
                        "caption": "Gambar kedua"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Hasil pengiriman gambar per nomor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "jid": { "type": "string" },
                          "error": { "type": "string", "nullable": true }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Device tidak ditemukan atau field wajib tidak ada",
            "content": {
              "application/json": {
                "example": { "error": "Device tidak ditemukan" }
              }
            }
          },
          "500": {
            "description": "Tidak ada device WA aktif atau socket belum siap",
            "content": {
              "application/json": {
                "example": { "error": "Tidak ada device WA aktif" }
              }
            }
          }
        }
      }
    }
  }
}
