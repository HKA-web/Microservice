                      },
                      "jid": {
                        "type": "string",
                        "description": "Nomor WhatsApp tujuan"
                      },
                      "documentUrl": {
                        "type": "string",
                        "description": "URL file atau Base64 (data:application/...)"
                      },
                      "fileName": {
                        "type": "string",
                        "description": "Nama file yang tampil di WhatsApp"
                      },
                      "caption": {
                        "type": "string",
                        "description": "Caption dokumen (optional)"
                      }
                    },
                    "required": [
                      "jid",
                      "documentUrl"
