{
  "paths": {
    "/api/send-document": {
      "post": {
        "summary": "Kirim dokumen WhatsApp (single atau multi)",
        "tags": ["WhatsApp"],
        "description": "Gunakan `_botDevice` untuk memilih device tertentu. Jika tidak diberikan, session pertama akan dipakai. Support URL dan Base64.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "_botDevice": {
                        "type": "string",
                        "description": "Device ID / nomor WA"
                      },
                      "jid": {
                        "type": "string",
                        "description": "Nomor WhatsApp tujuan"
                      },
                      "documentUrl": {
                        "type": "string",
                        "description": "URL file atau Base64 (data:application/...)"
                      },
                      "fileName": {
                        "type": "string",
                        "description": "Nama file yang tampil di WhatsApp"
                      },
                      "caption": {
                        "type": "string",
                        "description": "Caption dokumen (optional)"
                      }
                    },
                    "required": ["jid", "documentUrl"]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "_botDevice": {
                        "type": "string",
                        "description": "Device ID / nomor WA"
                      },
                      "messages": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "jid": {
                              "type": "string",
                              "description": "Nomor WhatsApp tujuan"
                            },
                            "documentUrl": {
                              "type": "string",
                              "description": "URL file atau Base64"
                            },
                            "fileName": {
                              "type": "string",
                              "description": "Nama file yang tampil"
                            },
                            "caption": {
                              "type": "string",
                              "description": "Caption dokumen (optional)"
                            }
                          },
                          "required": ["jid", "documentUrl"]
                        }
                      }
                    },
                    "required": ["messages"]
                  }
                ]
              },
              "examples": {
                "singleUrlDocument": {
                  "summary": "Kirim satu dokumen via URL",
                  "value": {
                    "_botDevice": "6285183xxxxxxx",
                    "jid": "62856xxxxx@s.whatsapp.net",
                    "documentUrl": "https://example.com/invoice.pdf",
                    "fileName": "invoice-feb-2026.pdf",
                    "caption": "Invoice bulan Februari"
                  }
                },
                "singleBase64Document": {
                  "summary": "Kirim dokumen via Base64",
                  "value": {
                    "jid": "62856xxxxx@s.whatsapp.net",
                    "documentUrl": "data:application/pdf;base64,JVBERi0xLjQKJ...",
                    "fileName": "laporan.pdf"
                  }
                },
                "multiDocument": {
                  "summary": "Kirim banyak dokumen sekaligus",
                  "value": {
                    "_botDevice": "6285183xxxxxxx",
                    "messages": [
                      {
                        "jid": "628564xxxxx@s.whatsapp.net",
                        "documentUrl": "https://example.com/report.xlsx",
                        "fileName": "report.xlsx"
                      },
                      {
                        "jid": "628121xxxxx@s.whatsapp.net",
                        "documentUrl": "https://example.com/manual.docx",
                        "fileName": "manual.docx",
                        "caption": "Panduan terbaru"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Hasil pengiriman dokumen per nomor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "jid": { "type": "string" },
                          "error": { "type": "string", "nullable": true }
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "successAll": {
                    "summary": "Semua dokumen berhasil",
                    "value": {
                      "data": [
                        { "jid": "628564xxxxx@s.whatsapp.net", "error": null },
                        { "jid": "628121xxxxx@s.whatsapp.net", "error": null }
                      ]
                    }
                  },
                  "partialError": {
                    "summary": "Sebagian gagal",
                    "value": {
                      "data": [
                        { "jid": "628564xxxxx@s.whatsapp.net", "error": null },
                        { "jid": "628121xxxxx@s.whatsapp.net", "error": "Socket WA belum siap" }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Device tidak ditemukan atau field wajib tidak ada",
            "content": {
              "application/json": {
                "example": { "error": "Device tidak ditemukan" }
              }
            }
          },
          "500": {
            "description": "Tidak ada device WA aktif atau socket belum siap",
            "content": {
              "application/json": {
                "example": { "error": "Tidak ada device WA aktif" }
              }
            }
          }
        }
      }
    }
  }
}
